# Copy to .env and fill in; scripts/deploy.sh and deploy-portal.py read it.

# AWS
export AWS_PROFILE=            # e.g. my-aws-profile
export AWS_REGION=eu-central-1
export PROJECT_NAME=github-mcp-ecs   # stacks are named ${PROJECT_NAME}-{gateway,network,target}

# Entra (single app: API audience + Kiro client + consent-portal client). See docs/ENTRA-SETUP.md.
export ENTRA_TENANT_ID=
export ENTRA_API_APP_ID=
# Secrets Manager ARN of an Entra client secret, stored as {"client_secret":"..."}
export ENTRA_PORTAL_CLIENT_SECRET_ARN=

# GitHub OAuth App. See docs/GITHUB-SETUP.md.
export GITHUB_CLIENT_ID=
# Secrets Manager ARN of the GitHub client secret, stored as {"client_secret":"..."}
export GITHUB_CLIENT_SECRET_ARN=
export GITHUB_CLIENT_SECRET_JSON_KEY=client_secret

# Private DNS name of the MCP endpoint (internal ALB) and a PUBLIC ACM cert for it,
# DNS-validated in a public zone you control. The name resolves only inside the VPC.
export MCP_DOMAIN_NAME=   # e.g. mcp-oc.example.com
export ACM_CERT_ARN=
export GITHUB_SCOPE=repo  # single scope for all tools on the target

# Optional overrides (defaults shown):
# export GITHUB_PROVIDER_NAME=github-mcp-provider
# export ENTRA_IDP_PROVIDER_NAME=github-mcp-portal-idp
# export INTERCEPTOR_MODE=REWRITE   # or LOG_ONLY
# export CONTAINER_CLI=podman

# PORTAL_* lines are appended by scripts/deploy-portal.py.
